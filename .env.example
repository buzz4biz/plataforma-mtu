# Database Configuration
# Para desenvolvimento local, use SQLite:
DATABASE_URL=file:./local.db

# Para produção com Turso (recomendado):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-auth-token

# Session Secret (gere uma string aleatória forte para produção)
SESSION_SECRET=change-this-to-a-random-secure-string-in-production

# API Keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=z-ai/glm-5.3-flashx

# AWS S3 (opcional, para upload de arquivos)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Server Configuration
PORT=3000
NODE_ENV=development

# OAuth (se implementado)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
